# Скопируйте в .env и заполните своими значениями (или заполните через UI: ui.bat). .env не коммитить.

# API-ключ Clore.ai: кабинет https://clore.ai -> Settings -> API
CLORE_API_KEY=
# Ключ доступа к вашей развёрнутой модели — придумайте любую случайную строку, например:
#   python -c "import secrets; print(secrets.token_hex(24))"
API_KEY=
# Токен Hugging Face (read) — нужен для gated-репозиториев и ускоряет скачивание
HF_TOKEN=
# Токен Hugging Face с правом записи — только если собираетесь публиковать
HF_TOKEN_WRITE=

# Выбранная модель (заполняется из UI, можно задать вручную: owner/name)
MODEL_REPO=
MODEL_NAME=
CTX=
ENGINE=

# Заполняется автоматически после аренды сервера на Clore
ORDER=
SERVER=
API_URL=
SSH=

# Telegram-отчёты (необязательно): бот от @BotFather и ваш chat_id
TG_BOT_TOKEN=
TG_CHAT_ID=
